
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ZAMÓWIENIA
// ==========================================

model orders {
  id             Int    @id @default(autoincrement())
  customer_name  String @db.VarChar(100)
  customer_email String @db.VarChar(255)

  // Pakiet i konfiguracja strony
  package      String  @db.VarChar(50)
  website_type String? @db.VarChar(30)
  hosting      Boolean @default(false)
  seo          Boolean @default(false)

  // Szczegóły projektu
  business_name String? @db.VarChar(150)
  description   String? @db.Text
  inspiration   String? @db.Text
  contact_email String? @db.VarChar(255)

  // Cena jednorazowa w groszach
  price Int

  // Płatności Stripe
  payment_status String @default("PENDING") @db.VarChar(20)

  stripe_checkout_session_id String?   @unique
  stripe_payment_intent_id   String?   @unique
  paid_at                    DateTime?

  // Realizacja zamówienia
  order_status String    @default("NEW") @db.VarChar(20)
  progress     Int       @default(0)
  stage        Int       @default(0)
  deadline     DateTime?

  // Data utworzenia
  created_at DateTime? @default(now()) @db.Timestamp(6)

  // Powiązanie z użytkownikiem
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Wiadomości dotyczące zamówienia
  messages OrderMessage[]

  @@index([userId])
}

// ==========================================
// UŻYTKOWNICY - BETTER AUTH
// ==========================================

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("CLIENT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth
  sessions Session[]
  accounts Account[]

  // Zamówienia użytkownika
  orders orders[]

  // Wiadomości wysłane przez użytkownika
  messages OrderMessage[]
}

// ==========================================
// SESJE UŻYTKOWNIKÓW
// ==========================================

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// ==========================================
// KONTA BETTER AUTH
// ==========================================

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

// ==========================================
// WERYFIKACJA BETTER AUTH
// ==========================================

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// CZAT KLIENT ↔ ADMINISTRATOR
// ==========================================

model OrderMessage {
  id        Int      @id @default(autoincrement())
  orderId   Int
  senderId  String
  content   String   @default("") @db.Text
  createdAt DateTime @default(now())

  order orders @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  attachments MessageAttachment[]

  @@index([orderId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  Int
  filename   String
  storageKey String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  message OrderMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}